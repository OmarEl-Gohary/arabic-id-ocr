{
  "title": "Arabic ID OCR - Production Dashboard",
  "uid": "arabic-ocr-prod",
  "schemaVersion": 38,
  "panels": [
    {
      "type": "stat",
      "title": "Total OCR Requests",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "targets": [{"expr": "sum(ocr_requests_total)", "legendFormat": "Total Requests"}]
    },
    {
      "type": "stat",
      "title": "Error Rate",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "targets": [{"expr": "sum(ocr_requests_total{status='error'}) / sum(ocr_requests_total)", "legendFormat": "Error Rate"}]
    },
    {
      "type": "graph",
      "title": "Request Latency (p50/p95/p99)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {"expr": "histogram_quantile(0.50, rate(ocr_request_duration_seconds_bucket[5m]))", "legendFormat": "p50"},
        {"expr": "histogram_quantile(0.95, rate(ocr_request_duration_seconds_bucket[5m]))", "legendFormat": "p95"},
        {"expr": "histogram_quantile(0.99, rate(ocr_request_duration_seconds_bucket[5m]))", "legendFormat": "p99"}
      ]
    },
    {
      "type": "graph",
      "title": "Fields Detected per Request",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [{"expr": "histogram_quantile(0.50, rate(ocr_fields_detected_per_request_bucket[5m]))", "legendFormat": "Median fields"}]
    },
    {
      "type": "graph",
      "title": "OCR Confidence by Field",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 12},
      "targets": [{"expr": "histogram_quantile(0.50, rate(ocr_field_confidence_bucket[5m])) by (field_name)", "legendFormat": "{{field_name}}"}]
    }
  ],
  "time": {"from": "now-1h", "to": "now"},
  "refresh": "30s"
}
