# ── Arabic ID OCR API — environment variables ──────────────────────────────
# Copy this file to .env and fill in your values.
# .env is git-ignored and must NEVER be committed.

# ── Authentication ──────────────────────────────────────────────────────────
# API key that mobile clients must send in the X-API-Key header.
# Leave empty (or unset) for open/dev mode — no auth enforced.
OCR_API_KEY=

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the mobile app.
# Use * to allow all origins (dev only).
ALLOWED_ORIGINS=*

# ── MLflow ──────────────────────────────────────────────────────────────────
# Tracking backend URI. SQLite for local; PostgreSQL/MySQL for production.
MLFLOW_TRACKING_URI=sqlite:///mlruns.db

# ── Model ───────────────────────────────────────────────────────────────────
# Override detector path without editing serving.yaml (useful in containers).
# DETECTOR_PATH=runs/train/arabic_id_detector/weights/best.pt
